# ---------------------------------------------------------------------------
# RSL Zone — environment variables
#
# 1. Copy this file to a new file named ".env" in the project root.
# 2. Go to your Supabase project -> Project Settings -> API.
# 3. Copy "Project URL" into VITE_SUPABASE_URL below.
# 4. Copy the "anon public" key (NOT the service_role key) into
#    VITE_SUPABASE_ANON_KEY below.
#
# NEVER put the service_role key in this file or anywhere in the frontend.
# The service_role key bypasses Row Level Security and must only ever be
# used in a trusted server environment (Supabase Edge Functions, etc.),
# never in code that ships to the browser.
# ---------------------------------------------------------------------------

VITE_SUPABASE_URL=YOUR_SUPABASE_URL
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
